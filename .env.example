# Container process identity. Match the Linux owner of ./data in production.
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# The API remains loopback-only until an authenticated HTTPS gateway fronts it.
FAMILY_SPENDING_BIND_ADDRESS=127.0.0.1
FAMILY_SPENDING_HTTP_PORT=8000

# Background automation.
FAMILY_SPENDING_SCHEDULER_ENABLED=true
FAMILY_SPENDING_CMB_EMAIL_POLL_ENABLED=false
FAMILY_SPENDING_EMAIL_POLL_INTERVAL_SECONDS=300

# Required only when FAMILY_SPENDING_CMB_EMAIL_POLL_ENABLED=true.
FAMILY_SPENDING_IMAP_ADDRESS=
FAMILY_SPENDING_IMAP_AUTH_CODE=
